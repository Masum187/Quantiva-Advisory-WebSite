# Unsplash API Configuration
# https://unsplash.com/oauth/applications/815471
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=your_access_key_here
UNSPLASH_SECRET_KEY=your_secret_key_here

# Contentful Configuration
REACT_APP_CONTENTFUL_SPACE_ID=your_space_id_here
REACT_APP_CONTENTFUL_ACCESS_TOKEN=your_access_token_here

# Cloudinary Configuration
REACT_APP_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# Admin / CMS / AI / video APIs and pages (required in production)
# Browser cookie: qa_admin=<same value>; path=/
ADMIN_API_SECRET=change-me-locally

# Public contact (optional overrides)
# NEXT_PUBLIC_CONTACT_EMAIL=info@quantiva-advisory.com
# NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_LINKEDIN_URL=

# Canonical site URL (must match the live domain)
# NEXT_PUBLIC_SITE_URL=https://quantivaadvisory.com

# Search Console / Bing HTML verification tokens
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Calendly — prefer a concrete event type over the org profile
# NEXT_PUBLIC_CALENDLY_EVENT_URL=https://calendly.com/quantivaadvisory/30min
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/quantivaadvisory
# CALENDLY_WEBHOOK_SIGNING_KEY=

# Mail (Brevo preferred, or Resend) — required for /api/contact and /api/whitepaper
# BREVO_API_KEY=
# RESEND_API_KEY=
# MAIL_FROM=Quantiva Advisory <mail@quantivaadvisory.com>
# LEAD_NOTIFY_EMAIL=info@quantiva-advisory.com
# CAREERS_NOTIFY_EMAIL=careers@quantiva-advisory.com
# BREVO_LIST_LEADS=
# BREVO_LIST_APPLICANTS=

# Optional Greenhouse Harvest ATS
# GREENHOUSE_HARVEST_API_KEY=
# GREENHOUSE_JOB_ID=
# GREENHOUSE_ON_BEHALF_OF=

# On-demand revalidation (Contentful webhook → POST /api/revalidate)
# REVALIDATE_SECRET=

# Contentful preview is server-only — never NEXT_PUBLIC
# CONTENTFUL_PREVIEW_TOKEN=
